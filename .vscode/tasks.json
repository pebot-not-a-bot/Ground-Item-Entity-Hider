{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RuneLite: start debug JVM",
      "type": "process",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [
        "run",
        "--debug-jvm",
        "--console=plain"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(NEVER_MATCH_THIS_PATTERN):(\\d+):(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Listening for transport dt_socket.*5005.*"
        }
      }
    }
  ]
}